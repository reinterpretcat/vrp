# Generated by Cargo
# will have compiled files and executables
target

# NOTE: Cargo.lock is deliberately committed, so that `--locked` and the CI cache keys mean something
# and dependabot can propose lockfile updates.

# scratch worktrees and experiments, each with their own lock file
.temp

# These are backup files generated by rustfmt
**/*.rs.bk

**/*.env

**/.DS_Store

# IDE
.idea
*.iml
.vscode

# python experiments
*.pyc
__pycache__
.venv
node_modules

# python distributions built by maturin
dist
*.whl
*.egg-info

# wasm packages built by wasm-pack, whose output directory names vary by target
pkg
pkg-*

# ignore files from heuristic playground, which writes them next to the workspace manifest.
# keep this anchored to the root: an unanchored *.png would also swallow images added under docs/
/*.png
heuristic_state.json

# output of solve_problem.sh, which writes next to the problem it was given. the checked-in test data
# uses a `.solution.` infix instead, so it is unaffected
*_solution.json
*_solution.geojson

# generated from the rust format types by vrp-cli/bindings/generate.sh. Rust is the source of truth;
# CI and release workflows generate these files before consuming them
/vrp-cli/bindings/schemas/
/vrp-cli/bindings/typescript/format_types.d.ts
# every model except the hand-written package and base-model modules
/vrp-cli/bindings/python/vrp_cli/models/*.py
!/vrp-cli/bindings/python/vrp_cli/models/__init__.py
!/vrp-cli/bindings/python/vrp_cli/models/_base.py

# profiler
callgrind*

.claude
